# OpenAI API
# HAR_ANALYZER_API_BASE_URL=https://api.openai.com/v1
# HAR_ANALYZER_API_KEY=sk-...
# HAR_ANALYZER_MODEL_NAME=gpt-4-turbo-preview

# Local LLM (LM Studio, vLLM, etc.)
HAR_ANALYZER_API_BASE_URL=http://127.0.0.1:8080/v1
HAR_ANALYZER_MODEL_NAME=local-model
HAR_ANALYZER_API_KEY=not-needed

# Ollama
# HAR_ANALYZER_API_BASE_URL=http://localhost:11434/v1
# HAR_ANALYZER_MODEL_NAME=llama3

# Optional settings
HAR_ANALYZER_MAX_TOKENS=4096
HAR_ANALYZER_TIMEOUT_SECONDS=120.0
HAR_ANALYZER_TEMPERATURE=0.3
